# ============================================================
# QUICK CARE Backend – Environment Variables
# Copy to .env and fill in real values
# ============================================================

# JWT
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-minimum-256-bits-long

# Google Gemini AI API key
# Get from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Firebase project ID (from Firebase console)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Server port (optional, default 8080)
# SERVER_PORT=8080

# Spring profile (dev uses in-memory fallback, prod uses real Firestore)
# SPRING_PROFILES_ACTIVE=dev
