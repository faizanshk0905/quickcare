# ===========================
# QUICK CARE - .gitignore
# ===========================

# ── Secrets & credentials ──────────────────────────────────────
backend/src/main/resources/firebase-service-account.json
backend/.env
frontend/.env
*.pem
*.key
*.p12
.env
.env.local
.env.*.local

# ── Java / Maven ───────────────────────────────────────────────
backend/target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── Node / npm / pnpm ─────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
dist/
build/
.cache/

# ── IDEs & Editors ─────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/
*.code-workspace

# ── OS generated ───────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Firebase ───────────────────────────────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
storage.rules.bak

# ── Logs ───────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Test coverage ──────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Misc ───────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
.temp/
tmp/
scratch/
